# Response headers for Cloudflare Workers Static Assets (this file is not served).
# Generated by build.py from src/index.html. Do not edit by hand: the CSP hashes
# must match the page's one <style> and one <script> byte for byte.
# no-cache: browsers check for a new copy on every load, so a deploy shows up at once.
# HSTS is not here: it is set once for the whole zone in Cloudflare (SSL/TLS, Edge Certificates).
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'none'; style-src 'sha256-474BZCK7+KJfk6+gKNl5jc64nivhoOoWHzwEU+X7Ef8='; script-src 'sha256-qKzRRa1BsoqolshK0/Jxv3ricH/oXpp4zFwRfFuRPkQ='; font-src data:; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
